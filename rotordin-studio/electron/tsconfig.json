{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "../src/domain/**/*.ts",
    "../src/runs/**/*.ts"
  ],
  "exclude": [
    "../src/**/*.test.ts"
  ]
}
