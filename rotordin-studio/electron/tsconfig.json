{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "../dist-electron",
    "rootDir": "..",
    "sourceMap": true
  },
  "include": [
    "./**/*.ts",
    "../src/domain/**/*.ts",
    "../src/runs/**/*.ts"
  ],
  "exclude": [
    "../src/**/*.test.ts"
  ]
}
